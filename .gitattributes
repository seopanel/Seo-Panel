# Paths excluded from `git archive` output (and therefore from GitHub's own
# "Download ZIP" / release tarball generation, and from build/build-release.sh,
# which builds on git archive) - dev-only content that ships in this repo for
# contributors but has no place in a customer-facing SEO Panel download.
#
# See build/build-release.sh and
# https://github.com/seopanel/Seo-Panel/wiki/Seo-Panel-Release---steps

CLAUDE.md                    export-ignore
data/test.php                export-ignore
build/                       export-ignore
.gitattributes               export-ignore

# Local dev Docker tooling (bind-mounts this checkout for live editing,
# builds a dev PHP/Apache image, proxies phpMyAdmin/spAPI) - not the
# customer-facing docker-compose.yml (kept in the release; that one runs a
# published image with no dev bind mounts). See docker-compose.override.yml.
Dockerfile                   export-ignore
docker-compose.override.yml  export-ignore
docker/                      export-ignore
